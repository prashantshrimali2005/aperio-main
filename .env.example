# Copy to .env.local and fill in. Never commit .env.local.

# Neon PostgreSQL connection string
DATABASE_URL=

# Server-side Gemini API key (never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
# Optional: comma-separated model fallback order (default: gemini-2.5-flash,gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth 2.0 "Web application" client (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin(s) of the deployed app, no trailing slash. Used to build the
# OAuth redirect URI so it matches one registered in Google Cloud Console.
# Accepts a comma-separated list when the app is served from more than one
# domain — the FIRST entry is primary (used for email/assistant links, and as
# the fallback for requests on any other host). Register EVERY origin's
# /api/v1/auth/google/callback URL in the Google Cloud Console.
# Local dev can leave this unset (falls back to the request origin).
APP_ORIGIN=https://aperio.sigmafusion.in,https://aperio-umber.vercel.app

# Optional: ambient background video (.mp4) for the /login and /register right
# panel. Defaults to the bundled public/auth-bg.mp4. Any hosted .mp4 URL works.
NEXT_PUBLIC_AUTH_VIDEO_URL=

# Telegram automated messages (roadmap reminders, weekly digest, analysis updates).
# Create a bot with @BotFather -> token; set the bot's @username (no @).
# After deploy, register the webhook:
#   curl "https://api.telegram.org/bot<token>/setWebhook?url=https://<domain>/api/v1/integrations/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Shared secret for the notification cron (Vercel sends it as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Admin area. Comma-separated emails that get the /admin dashboard on sign in.
ADMIN_EMAILS=you@example.com,teammate@example.com
# Master key that encrypts integration credentials stored in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
APP_ENCRYPTION_KEY=

# Razorpay — paid courses / practice sets. Free items (price 0) never hit this.
# Both come from Razorpay Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: ipinfo.io token. When set, sign-in security emails include the
# ISP / network name and fall back to ipinfo for city/country when the Vercel
# edge geo headers aren't present (e.g. local dev). Free tier: 50k lookups/mo.
# https://ipinfo.io/signup  — leave blank to send alerts with IP + device only.
IPINFO_TOKEN=
